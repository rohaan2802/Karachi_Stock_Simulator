{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build simulator",
      "type": "shell",
      "command": ".\\build.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Run simulator",
      "type": "shell",
      "command": ".\\run.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
